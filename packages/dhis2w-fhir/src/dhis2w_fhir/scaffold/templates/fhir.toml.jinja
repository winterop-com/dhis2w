# fhir.toml - configuration for `d2w fhir generate` (scaffolded by `d2w fhir init`).
# Only the essentials live here; every available option is documented with its default
# in fhir.example.toml beside this file, and explained in depth at
# https://winterop-com.github.io/dhis2w/fhir/301-fhir-toml/

{% if profile %}
profile = "{{ profile }}"           # DHIS2 profile to read metadata from
{% else %}
# profile = "myserver"              # optional: DHIS2 profile to read metadata from
{% endif %}

[ig]
id = "{{ ig_id }}"
canonical = "{{ canonical }}"
name = "{{ name }}"
title = "{{ title }}"
publisher = "{{ publisher }}"
# "draft" while building; "active" for production - drives the sushi-config status
# and the status and experimental flag on every generated CodeSystem/ValueSet/Questionnaire.
status = "{{ status }}"
{% if kind == "registry" %}
# This project publishes the DHIS2 organisation-unit registry as a package of its own, and no
# form: a guide names it under [generate.organisation_units.registry] and references every
# Location and Organization here by its URL under this package's canonical.
kind = "registry"
{% endif %}

[generate]
# A DHIS2 name carrying '<' ("Female, <15y") aborts the IG publisher's final pass,
# and a DHIS2 code carrying a space ("Pre eclampsia") collides on the publisher's
# anchors and needs escaping in every URL below them. "substitute" publishes such
# names rewritten readably ("Female, under 15y") and such codes hyphenated
# ("Pre-eclampsia"), and prints every rewrite; DHIS2 itself is never modified, no
# UID is touched, and each rewritten concept states its DHIS2 code as a
# `dhis2-code` property. "refuse" publishes names and codes byte-true and refuses
# the run on a '<' name instead; removing the key makes each run ask.
hostile_names = "substitute"
{% if max_level or registry %}

[generate.organisation_units]
{% if max_level %}
# Every unit emits two instances, an Organization and a Location, and a hierarchy fans out at
# the bottom - so the deepest level is usually most of the IG, and most of its compile time.
max_level = {{ max_level }}
{% endif %}
{% if registry %}

[generate.organisation_units.registry]
# The package publishing the organisation units this guide's forms refer to. This guide writes
# no Organization or Location of its own and references each unit by its URL under that
# package's canonical; `make build` installs the package first (see REGISTRY_TGZ in the Makefile).
id = "{{ registry.id }}"
canonical = "{{ registry.canonical }}"
version = "{{ registry.version }}"
{% if registry.path %}
# A local checkout of the registry project, whose build wrote the package `make build` installs.
path = "{{ registry.path.as_posix() }}"
{% endif %}
{% endif %}
{% endif %}
{% if data_set_ids %}

[generate.data_sets]
include_ids = [{% for uid in data_set_ids %}"{{ uid }}"{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
{% if event_program_ids %}

[generate.event_programs]
include_ids = [{% for uid in event_program_ids %}"{{ uid }}"{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
{% if tracker_program_ids %}

[generate.tracker_programs]
include_ids = [{% for uid in tracker_program_ids %}"{{ uid }}"{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
{% if selection %}

{{ selection }}
{% endif %}
