# Maintained by `d2w fhir init --refresh`, which rewrites this file whole from the current
# scaffold. An edit written into THIS file does not survive that. Its knobs are the `?=` defaults
# below: set one on the command line (`make build JAVA_HEAP=4g`) or in the environment, where the
# value lives outside the file and a refresh cannot reach it.
DOCKER_IMAGE := fhir-ig
IG_DIR := ig
TX_SERVER ?= http://tx.fhir.org
# The publisher JVM heap ceiling. Leave it empty and each build sizes it to this machine: the
# memory docker reports, less 2G, floored at 4g and capped at 31g. On macOS and Windows that figure
# is the VM Docker Desktop runs; on Linux it is the whole machine's RAM, whatever else is running on
# it - so name a ceiling yourself on a shared build host.
#
# The 2G of headroom is deliberately generous. A publisher build is a monthly act and it wants the
# machine to itself: the publisher and Jekyll share one container, Jekyll renders the site at the
# very end with the JVM still resident, and a heap has the JVM's own metaspace and native memory
# around it. Stop your other containers for the run, and if the kernel's out-of-memory killer takes
# the publisher anyway, the build says so and names every way out.
#
# 31g is the top because the JVM drops compressed object pointers above roughly 32 GB, where the
# same live set suddenly costs materially more heap; the largest guide measured peaked at 16.
#
# It is a ceiling, not a reservation: a guide that needs less simply uses less. Set JAVA_HEAP
# whenever you want a particular ceiling - on the command line (`make build JAVA_HEAP=8g`) or in the
# environment - and an empty value derives exactly as an unset one does. The value lives outside
# this file, so a refresh leaves it alone.
JAVA_HEAP ?=
# The one question a build puts to docker, asked when something first needs the answer and
# remembered from then on: `$(eval ...)` rewrites this variable to what the shell said, so `help`,
# `clean` and `generate` never ask, and a build asks once however many places read it. Only the
# first record is taken - a daemon that prints a warning line ahead of the number would otherwise
# hand make two values and the publisher two -Xmx arguments - and anything but a number lands on 8g
# with the memory reported as unknown. The answer is "<ceiling> <memory>", split apart below.
DOCKER_MEMORY_READING = $(eval DOCKER_MEMORY_READING := $(shell docker info --format '{% raw %}{{.MemTotal}}{% endraw %}' 2>/dev/null \
	| awk 'NR == 1 { if ($$1 ~ /^[0-9]+$$/) { gigabytes = int(($$1 / 1073741824) - 2); \
		if (gigabytes < 4) gigabytes = 4; if (gigabytes > 31) gigabytes = 31; \
		printf "%dg %.1f GB\n", gigabytes, $$1 / 1073741824 } else print "8g unknown"; exit } \
		END { if (NR == 0) print "8g unknown" }'))$(DOCKER_MEMORY_READING)
# What the publisher is actually given, and where that number came from. A JAVA_HEAP set to a value
# is taken as it stands and docker is never asked; empty or unset derives.
PUBLISHER_HEAP = $(if $(strip $(JAVA_HEAP)),$(strip $(JAVA_HEAP)),$(word 1,$(DOCKER_MEMORY_READING)))
HEAP_SOURCE = $(if $(strip $(JAVA_HEAP)),set by JAVA_HEAP,docker memory $(wordlist 2,3,$(DOCKER_MEMORY_READING)))

# The toolchain uv.lock pins. Override to run a checkout: D2W="uv run --project /path/to/dhis2w d2w"
D2W ?= uv run d2w
# Named volume for the FHIR package cache - the bulk of a cold build's wall clock.
CACHE_VOLUME := fhir-ig-cache
# Where `build` runs the publisher: a directory on the container's own filesystem rather than the
# mounted project. See the comment on that target for why.
BUILD_WORKDIR := /home/publisher/work
# What comes back out of that directory when the publisher is done. The site, the resources SUSHI
# compiled - `validate`, `check-artifacts` and the FHIR endpoint all read those - and the terminology
# and package caches the next build reuses. `temp/` and `template/` stay behind: nothing reads them,
# and they are the bulk of what a build writes.
BUILD_CARRIED_BACK := output fsh-generated input-cache

# The tail both builds run once the container is gone: read what the run left behind, say which
# kill it was, and hand the publisher's own status back to make. Exit 137 says only that something
# SIGKILLed the publisher, and a `docker stop`, a `docker kill` and a timeout around the build all
# look identical from here - so the container reports its own cgroup's out-of-memory count as it
# exits, and that count is what tells the two apart.
define REPORT_KILL
	status=$$(cat "$$run/status" 2>/dev/null || echo 1); \
	oom_kills=$$(awk '/^container out-of-memory kills: / { count = $$NF } END { print count + 0 }' \
		"$$run/log" 2>/dev/null); \
	rm -rf "$$run"; \
	if [ $$status -eq 137 ] && [ $$oom_kills -gt 0 ]; then $(REPORT_OOM_KILL); \
	elif [ $$status -eq 137 ]; then $(REPORT_OTHER_KILL); fi; \
	exit $$status
endef

# What a build prints when the kernel's out-of-memory killer took the publisher. The two memory
# failures need opposite fixes - too large a ceiling for the machine is a SIGKILL, too small a one
# for the guide is an OutOfMemoryError - so the message names both. The container list and the step
# that acts on it are printed only when something else is in fact running, rather than heading the
# list with advice that does not apply.
define REPORT_OOM_KILL
	printf '%s\n' \
		'' \
		'================================================================' \
		'  BUILD KILLED - out of memory (exit 137)' \
		'================================================================' \
		"  The kernel's out-of-memory killer took the publisher. This is" \
		'  not a build error: ig/output holds whatever the last completed' \
		'  build wrote, or is partial - the site is written last, so' \
		'  nothing from this run is trustworthy.' \
		''; \
	printf '    %-14s %s\n' 'heap ceiling' '-Xmx$(PUBLISHER_HEAP) ($(HEAP_SOURCE))'; \
	others=$$(docker ps --format '{% raw %}{{.Names}}  {{.Image}}{% endraw %}' 2>/dev/null); \
	if [ -n "$$others" ]; then \
		printf '%s\n' '' '  Containers running now, sampled after the kill:'; \
		printf '%s\n' "$$others" | sed 's/^/      /'; \
	fi; \
	printf '%s\n' '' '  Ways out, best first:' ''; \
	step=1; \
	if [ -n "$$others" ]; then \
		printf '    %d. Stop those containers and run it again - a publisher\n' $$step; \
		printf '%s\n' '       build wants the machine to itself.'; \
		step=$$((step + 1)); \
	fi; \
	printf '    %d. Give docker more memory. Docker Desktop: Settings >\n' $$step; \
	printf '%s\n' '       Resources > Memory. Linux: docker uses the memory of' \
		'       the machine it runs on, so free some there.'; \
	step=$$((step + 1)); \
	printf '    %d. Lower the ceiling:  make build JAVA_HEAP=<smaller>\n' $$step; \
	printf '%s\n' \
		'' \
		'  The opposite failure looks different: OutOfMemoryError with a Java' \
		'  stack trace means the ceiling is too SMALL. Raise it instead.' \
		'================================================================' \
		''
endef

# What a build prints on the other 137: the publisher was SIGKILLed, and the container's cgroup
# counted no out-of-memory kill.
define REPORT_OTHER_KILL
	printf '%s\n' \
		'' \
		'================================================================' \
		'  BUILD KILLED (exit 137)' \
		'================================================================' \
		"  Something other than the kernel's out-of-memory killer SIGKILLed" \
		'  the publisher: a docker stop, a docker kill, a timeout around the' \
		'  build. No out-of-memory kill was counted in the container cgroup -' \
		'  a host on cgroup v1 counts none either way, so read the log again' \
		'  if memory is what you suspect.' \
		'' \
		'  ig/output holds whatever the last completed build wrote, or is' \
		'  partial - the site is written last, so nothing from this run is' \
		'  trustworthy.' \
		'================================================================' \
		''
endef
{% if registry %}
# The organisation-unit registry package this guide depends on, from fhir.toml's
# [generate.organisation_units.registry]. SUSHI and the publisher resolve a dependency from the
# package cache, so `sushi` and `build` install it there first. REGISTRY_TGZ is the package.tgz the
# registry project's own `make build` wrote; the default follows `registry.path` in fhir.toml when
# one is set, and either way it can be named on the command line.
REGISTRY_ID ?= {{ registry.id }}
REGISTRY_VERSION ?= {{ registry.version }}
REGISTRY_TGZ ?= {{ registry.path.as_posix() ~ "/ig/output/package.tgz" if registry.path else "" }}
{% endif %}

.PHONY: cache-init help setup upgrade generate validate sushi build refresh clean clean-all

help:  ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "%-12s %s\n", $$1, $$2}'

setup:  ## Build the SUSHI + IG publisher docker image
	docker build -t $(DOCKER_IMAGE) .

upgrade:  ## Rebuild the image from scratch, pulling the latest SUSHI + IG publisher
	docker build --pull --no-cache -t $(DOCKER_IMAGE) .

generate:  ## Regenerate FSH from DHIS2 metadata
	$(D2W) fhir generate

.PHONY: update
update:  ## Update the project to the current d2w: move the toolchain pin, sync, refresh the scaffold-managed files
	uv lock --upgrade
	uv sync
	$(D2W) fhir init --refresh

validate:  ## Check the DHIS2 instance's codes/names for FHIR-safety (writes md/csv/pdf; exit 1 on errors)
	$(D2W) fhir validate

.PHONY: check

check:  ## Scan the artifacts on disk for what aborts the IG publisher (offline, seconds, exit 1 on findings)
# A finding fails this recipe loudly; a toolchain too old to know the command must not. A project
# whose lock pins a dhis2w-fhir without `check-artifacts` (1.8+) would otherwise die here on
# "No such command" and take `build` down with it - on a guide that is perfectly publishable. So
# ask the CLI what it knows first, and when the command is absent, warn with the upgrade named
# and let the build proceed unscanned.
	@if $(D2W) fhir --help 2>/dev/null | grep -q "check-artifacts"; then \
		$(D2W) fhir check-artifacts; \
	else \
		echo "WARNING: the pinned dhis2w-fhir has no 'd2w fhir check-artifacts' (1.8+); skipping the artifact scan. Upgrade: uv lock --upgrade && uv sync"; \
	fi

cache-init:  ## Ensure the shared package-cache volume is writable by the publisher user
	docker run --rm -u root -v $(CACHE_VOLUME):/home/publisher/.fhir --entrypoint sh $(DOCKER_IMAGE) -c "mkdir -p /home/publisher/.fhir/packages && chown -R 1001:1001 /home/publisher/.fhir"

{% if registry %}
.PHONY: registry-present registry-install

registry-present:  ## Check the registry archive is on disk, before anything reaches docker
# Two `test` calls and no docker at all, and it runs ahead of cache-init in every target that needs
# the registry: a run that cannot finish must not leave the $(CACHE_VOLUME) volume behind it.
	@test -n "$(REGISTRY_TGZ)" || { \
		echo "REGISTRY_TGZ is empty: name the registry build's archive (make registry-install REGISTRY_TGZ=../registry/ig/output/package.tgz), or set registry.path in fhir.toml and run 'd2w fhir init --refresh'"; \
		exit 1; }
	@test -f "$(REGISTRY_TGZ)" || { \
		echo "$(REGISTRY_TGZ): no such file - run 'make build' in the registry project first."; \
		echo "  Only a compile needs it. 'd2w fhir serve --live' and 'd2w fhir forward' read the two projects as they stand, so neither needs a build of either one."; \
		exit 1; }

registry-install: registry-present cache-init  ## Install the registry package this guide depends on into the package cache
# The cache holds one directory per package and version, `<id>#<version>/package/`, which is the
# layout a package.tgz unpacks to. The archive is streamed in over stdin so no host path is mounted.
	docker run --rm -i -u root -v $(CACHE_VOLUME):/home/publisher/.fhir --entrypoint sh $(DOCKER_IMAGE) -c \
		'set -e; target="/home/publisher/.fhir/packages/$(REGISTRY_ID)#$(REGISTRY_VERSION)"; \
		rm -rf "$$target"; mkdir -p "$$target"; tar -C "$$target" -xzf -; chown -R 1001:1001 "$$target"' \
		< "$(REGISTRY_TGZ)"

sushi: registry-present cache-init registry-install  ## Compile FSH to FHIR resources
{% else %}
sushi: cache-init  ## Compile FSH to FHIR resources
{% endif %}
# SUSHI writes $(IG_DIR)/fsh-generated as it goes and keeps whatever it had written when it stopped
# on an error, so a failed compile leaves a directory shaped like a finished guide - and the FHIR
# endpoint further down reads that directory, so it would publish those Questionnaires as though the
# compile had succeeded. The partial write is removed here, which makes the presence of
# fsh-generated mean what it says: a compile that finished. SUSHI's own exit status is what make
# sees, and the removal is reported above it.
	@status=0; \
	docker run --rm -v $$(pwd)/$(IG_DIR):/home/publisher/ig -v $(CACHE_VOLUME):/home/publisher/.fhir \
		$(DOCKER_IMAGE) sushi . || status=$$?; \
	if [ $$status -ne 0 ]; then \
		rm -rf $(IG_DIR)/fsh-generated; \
		echo "SUSHI stopped on an error. Removed $(IG_DIR)/fsh-generated, which held a partial compile: the FHIR endpoint has nothing to read until a compile finishes."; \
	fi; \
	exit $$status

{% if registry %}
build: registry-present cache-init registry-install  ## Run the full IG publisher
{% else %}
build: cache-init  ## Run the full IG publisher
{% endif %}
# The scan first, and a finding stops the build here. A DHIS2 name or code carrying '<' survives every
# pass of the publisher and kills the last one, after every resource has already been rendered - hours
# spent to be told a page failed to parse. Reading the same files the publisher reads answers in
# seconds and names the object. Generation carries the same gate, but a build publishes what is on
# disk: output written before the gate, output from an older toolchain pin, and hand-authored FSH.
	$(MAKE) check
# Then the publisher, run on the container's own disk rather than on the mounted project. Docker on
# macOS reaches a host directory over a network-style filesystem, and the publisher's output pass
# writes tens of thousands of small files one at a time: on a district-scale guide that single pass
# took 341 seconds through the mount and 21 seconds inside the container. So the project is streamed
# in, built there, and the results streamed back - two bulk copies instead of one file at a time.
# Linux mounts a host directory directly and pays none of that; the recipe is the same either way
# because a project that builds one way on one machine should build the same way on the other.
# The heap is stated up front because it is sized to this machine rather than written in this file,
# and a number nobody can see is a number nobody can question. The peak the container actually
# reached and its cgroup's out-of-memory count are read from inside before it exits - `--rm` takes
# the container away, so it cannot be asked afterwards - and printed either way. On a kill they are
# the evidence for which kill it was; on a success the peak is the only thing that ever answers "is
# the ceiling big enough" with a measurement. `tee` keeps a copy of the run for the two lines make
# reads back, and the status comes out in a file because the pipe would otherwise swallow it.
	@printf 'publisher heap %s, %s\n' '$(PUBLISHER_HEAP)' '$(HEAP_SOURCE)'
	@run=$$(mktemp -d "$${TMPDIR:-/tmp}/publisher-build.XXXXXX") || exit 1; \
	{ docker run --rm -v $$(pwd)/$(IG_DIR):/mnt/ig -v $(CACHE_VOLUME):/home/publisher/.fhir \
		$(DOCKER_IMAGE) bash -c 'set -e; \
			rm -rf $(BUILD_WORKDIR); mkdir -p $(BUILD_WORKDIR); \
			tar -C /mnt/ig --exclude=./output --exclude=./temp --exclude=./template -cf - . \
				| tar -C $(BUILD_WORKDIR) -xf -; \
			cd $(BUILD_WORKDIR); \
			status=0; \
			java -Xmx$(PUBLISHER_HEAP) -jar /home/publisher/.ig-publisher/publisher.jar ig.ini -ig . -tx $(TX_SERVER) \
				|| status=$$?; \
			awk "{ printf \"peak container memory %.1f GB\n\", \$$1 / 1073741824 }" \
				/sys/fs/cgroup/memory.peak 2>/dev/null || true; \
			awk "/^oom_kill / { printf \"container out-of-memory kills: %d\n\", \$$2 }" \
				/sys/fs/cgroup/memory.events 2>/dev/null || true; \
			for carried in $(BUILD_CARRIED_BACK); do \
				if [ -d "$(BUILD_WORKDIR)/$$carried" ]; then \
					rm -rf "/mnt/ig/$$carried"; \
					tar -C $(BUILD_WORKDIR) -cf - "$$carried" | tar -C /mnt/ig -xf -; \
				fi; \
			done; \
			exit $$status'; echo $$? > "$$run/status"; } | tee "$$run/log"; \
	$(REPORT_KILL)

.PHONY: build-bind

{% if registry %}
build-bind: registry-present cache-init registry-install  ## Run the publisher straight over the mounted project, no copy in or out
{% else %}
build-bind: cache-init  ## Run the publisher straight over the mounted project, no copy in or out
{% endif %}
# The same build without the two copies. Worth reaching for when you want to watch output/ fill up
# as it is written, or when a copy is what you suspect. On macOS it is the slower of the two.
	$(MAKE) check
# The publisher runs over the mounted project, and the shell around it is there for one reason: to
# read the peak and the cgroup's out-of-memory count once the JVM is done, which is what tells a
# kernel out-of-memory kill from any other SIGKILL.
	@printf 'publisher heap %s, %s\n' '$(PUBLISHER_HEAP)' '$(HEAP_SOURCE)'
	@run=$$(mktemp -d "$${TMPDIR:-/tmp}/publisher-build.XXXXXX") || exit 1; \
	{ docker run --rm -v $$(pwd)/$(IG_DIR):/home/publisher/ig -v $(CACHE_VOLUME):/home/publisher/.fhir \
		$(DOCKER_IMAGE) bash -c 'status=0; \
			java -Xmx$(PUBLISHER_HEAP) -jar /home/publisher/.ig-publisher/publisher.jar ig.ini -ig . -tx $(TX_SERVER) \
				|| status=$$?; \
			awk "{ printf \"peak container memory %.1f GB\n\", \$$1 / 1073741824 }" \
				/sys/fs/cgroup/memory.peak 2>/dev/null || true; \
			awk "/^oom_kill / { printf \"container out-of-memory kills: %d\n\", \$$2 }" \
				/sys/fs/cgroup/memory.events 2>/dev/null || true; \
			exit $$status'; echo $$? > "$$run/status"; } | tee "$$run/log"; \
	$(REPORT_KILL)

.PHONY: serve serve-live

serve:  ## Serve the compiled IG as a FHIR endpoint, with the capture UI at / (run generate + sushi first)
	$(D2W) fhir serve --ui

serve-live:  ## Serve straight from the DHIS2 instance, with the capture UI at / - no compile needed
	$(D2W) fhir serve --live --ui

{% if not publishes %}
.PHONY: forward forward-import

forward:  ## Dry-run the capture spool against DHIS2 - validate only, nothing written, nothing moved
	$(D2W) fhir forward

forward-import:  ## Import the capture spool into DHIS2 and file every receipt by what it became
	$(D2W) fhir forward --import
{% else %}
# No forward targets: a capture starts from a Questionnaire, this package publishes none, and the
# spool it would drain can never fill. The guide that depends on this package is where captures
# are made and forwarded.
{% endif %}

clean:  ## Remove build output (keeps ig/input-cache, the terminology cache the next build reuses)
	rm -rf $(IG_DIR)/fsh-generated $(IG_DIR)/output $(IG_DIR)/temp $(IG_DIR)/template \
		$(IG_DIR)/translations $(IG_DIR)/Requirements-fromNarrative.json

clean-all: clean  ## Also remove the terminology cache and the FHIR package cache volume
	rm -rf $(IG_DIR)/input-cache
# The package cache volume is shared by every project scaffolded on this machine, so removing it
# here makes the next build of each of them a cold one; a volume another project already removed is
# reported, not treated as a failure.
	@if docker volume inspect $(CACHE_VOLUME) >/dev/null 2>&1; then \
		docker volume rm $(CACHE_VOLUME); \
	else \
		echo "$(CACHE_VOLUME): no package cache volume to remove"; \
	fi

# The caches survive a refresh on purpose. The terminology cache is hours of tx.fhir.org
# round-trips on a large guide, the package cache is re-downloads, and neither can go stale
# under a tooling upgrade - both are keyed by what they hold. `make clean-all` first is the
# deliberate act when you really want them gone.
refresh:  ## Wipe build output, pull latest tooling, regenerate, revalidate, rebuild (keeps the caches)
	$(MAKE) clean
	$(MAKE) upgrade
	$(MAKE) generate
# The leading dash keeps the rebuild going: validate exits 1 on instance code errors by design,
# and a full refresh wants fresh reports out of it, not an abort. The dash rather than --no-fail,
# because --no-fail also drops the red "N error(s) found" line - the one thing worth reading here.
	-$(MAKE) validate
# No sushi step: the publisher runs its own SUSHI over the same FSH, so calling both
# compiles everything twice - the single largest cost in the chain.
	$(MAKE) build
