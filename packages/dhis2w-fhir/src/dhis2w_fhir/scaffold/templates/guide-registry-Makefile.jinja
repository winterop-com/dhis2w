# Maintained by `d2w fhir init --refresh`, which rewrites this file whole from the current
# scaffold. An edit written into THIS file does not survive that; set a knob on the command line
# (`make build JAVA_HEAP=8g`) or in the environment, where the value lives outside the file.
#
# The two projects of a split guide, driven as one. Each keeps its own Makefile - the one
# `d2w fhir init` wrote, with its own docker run. This file does nothing they cannot do; it puts
# them in the right order and saves you two `cd`s.
#
# THE ORDER IS THE POINT. The registry builds first and writes a package; the guide installs that
# package and builds against it. A guide built first has a dependency the publisher cannot resolve.
#
# So this file runs its own targets one at a time, and `make -j2 build` or a `-j` inherited through
# MAKEFLAGS builds the registry to completion before the guide starts. `.NOTPARALLEL` says that in
# one line and says it for every target here, which a recipe spelling the steps out serially would
# have to repeat in `build` and in `all`. It reaches no further than this file: each `$(MAKE) -C`
# below is a make of its own and parallelises its own recipes as usual.
#
# The cost is `generate`: its two reads of the DHIS2 instance are independent and could have run
# together, so a `-j` here buys nothing and the two generates take their two turns. Run them side
# by side with two shells when that matters - `make generate-registry` and `make generate-guide`
# are each a target of its own.
.NOTPARALLEL:

REGISTRY := {{ registry_root }}
GUIDE    := {{ guide_root }}

# JAVA_HEAP is the publisher's JVM heap ceiling, and one knob covers the two builds because a
# ceiling is not a reservation: the registry renders one resource per organisation unit and grows
# into it, the guide renders its forms and does not. Name it on the command line or in the
# environment and make carries it to both projects itself - there is nothing to forward here:
#   make build JAVA_HEAP=8g
# Left alone, each project sizes its own ceiling from the memory docker reports, and an empty value
# reaching a project derives exactly as an unset one does.

# The toolchain both projects run. Each resolves `d2w` from its own uv.lock by default, which is a
# PyPI release rather than a checkout. Point this at a checkout to run unreleased code:
#   make all D2W="uv run --project /path/to/dhis2w d2w"
D2W ?= uv run d2w

# The flags every sub-make carries. `$(MAKE)` itself stays in each recipe line below, spelled out
# rather than wrapped in a variable make would have to expand first: make reads the literal token
# to recognise the line as recursion, which is what makes `make -n` reach the child and what hands
# the child the jobserver.
PROJECT_FLAGS = D2W="$(D2W)"

.PHONY: help
help:  ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "%-16s %s\n", $$1, $$2}'

.PHONY: toolchain
toolchain:  ## Print the d2w each project resolves - the first thing to check when a key reads "unknown"
# `uv run d2w` resolves from the project's own lock, which is a release, not this machine's
# checkout. A release that predates a key refuses the fhir.toml by name, which reads like a typo
# rather than a version gap. `make update` in each project moves the pin.
	@printf '%-10s ' "$(REGISTRY):"; cd $(REGISTRY) && $(D2W) --version 2>/dev/null || echo "not resolvable"
	@printf '%-10s ' "$(GUIDE):";    cd $(GUIDE)    && $(D2W) --version 2>/dev/null || echo "not resolvable"

.PHONY: update
update:  ## Move both projects to the current d2w - each pin, sync and scaffold - then refresh this Makefile and the README
# Each project moves its own pin, because each resolves `d2w` from its own lock. This file and the
# README belong to neither, so the pair is refreshed last, through the guide's freshly moved toolchain.
	@$(MAKE) -C $(REGISTRY) $(PROJECT_FLAGS) update
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) update
	cd $(GUIDE) && $(D2W) fhir init --refresh ..

.PHONY: setup
setup:  ## Build the SUSHI + IG publisher docker image (once per machine, shared by both projects)
	@$(MAKE) -C $(REGISTRY) $(PROJECT_FLAGS) setup

.PHONY: generate
generate: generate-registry generate-guide  ## Generate both projects from the DHIS2 instance

.PHONY: generate-registry
generate-registry:  ## Generate the registry package alone
	@$(MAKE) -C $(REGISTRY) $(PROJECT_FLAGS) generate

.PHONY: generate-guide
generate-guide:  ## Generate the guide alone - resolves the unit identities, writes no unit
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) generate

.PHONY: build
build: build-registry build-guide  ## Build both, in the only order that resolves

.PHONY: build-registry
build-registry:  ## Build the registry package -> $(REGISTRY)/ig/output/package.tgz
	@$(MAKE) -C $(REGISTRY) $(PROJECT_FLAGS) build

.PHONY: build-guide
build-guide:  ## Install the registry package into the publisher's cache, then build the guide
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) build

.PHONY: install-registry
install-registry:  ## Install the built package into the shared package cache, without building the guide
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) registry-install

.PHONY: check
check:  ## Scan both offline for what aborts the publisher, including unit references the package lacks
	@$(MAKE) -C $(REGISTRY) $(PROJECT_FLAGS) check
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) check

.PHONY: serve
serve:  ## Serve the guide with the capture UI - the forms, and the units out of the registry
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) serve

.PHONY: serve-registry
serve-registry:  ## Serve the registry alone - a readable FHIR endpoint over the hierarchy, no forms
	@$(MAKE) -C $(REGISTRY) $(PROJECT_FLAGS) serve

.PHONY: forward
forward:  ## Dry-run the guide's capture spool against DHIS2 - nothing is written
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) forward

.PHONY: all
all: generate build  ## Generate and build both, end to end

.PHONY: clean
clean:  ## Remove build output from both, keeping the caches that cost hours to refill
	@$(MAKE) -C $(REGISTRY) $(PROJECT_FLAGS) clean
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) clean

.PHONY: clean-all
clean-all:  ## Also remove both terminology caches and the shared package volume - the next build is cold
# Both projects, not just the registry: each keeps its own ig/input-cache, and only that project's
# own `clean-all` removes it. The docker package-cache volume is shared, so the first call takes it
# and the second reports it already gone rather than failing.
	@$(MAKE) -C $(REGISTRY) $(PROJECT_FLAGS) clean-all
	@$(MAKE) -C $(GUIDE) $(PROJECT_FLAGS) clean-all
